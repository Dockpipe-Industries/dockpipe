module Dockpipe.SDK;

// Workflow exit status is observed data, including a nonzero exitCode.
// An exited root process does not alone prove that its owned tree is complete.
public Record OperationObservation {
    public OperationId id;
    public bool exited;
    public bool treeComplete;
    public bool forced;
    public int exitCode;
    public int reapedChildren;
    public string stdoutText;
    public string stderrText;
    public string scopePath;
    public bool stdoutTruncated;
    public bool stderrTruncated;
}
