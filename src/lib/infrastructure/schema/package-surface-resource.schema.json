{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dockpipe package surface snapshot resource",
  "type": "object",
  "required": [
    "id",
    "title",
    "state",
    "details",
    "actions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00\\r\\n]+$"
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "state": {
      "type": "string",
      "maxLength": 160
    },
    "details": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "maxLength": 160
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "display": {
      "$ref": "package-native-display.schema.json"
    },
    "launch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    }
  }
}
