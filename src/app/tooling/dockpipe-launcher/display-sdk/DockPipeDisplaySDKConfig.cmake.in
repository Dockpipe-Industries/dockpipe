@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.10.3 EXACT COMPONENTS Widgets)
set(DockPipeDisplaySDK_VERSION "@PROJECT_VERSION@")
set(DockPipeDisplaySDK_INTERFACE "com.dockpipe.launcher.DisplayPackage/1.0")
set(DockPipeDisplaySDK_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(DockPipeDisplaySDK_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(DockPipeDisplaySDK_SYSTEM_NAME "@CMAKE_SYSTEM_NAME@")
set(DockPipeDisplaySDK_SYSTEM_PROCESSOR "@CMAKE_SYSTEM_PROCESSOR@")
foreach(field IN ITEMS SYSTEM_NAME SYSTEM_PROCESSOR CXX_COMPILER_ID CXX_COMPILER_VERSION)
    if(field STREQUAL "CXX_COMPILER_ID")
        set(expected "${DockPipeDisplaySDK_COMPILER_ID}")
    elseif(field STREQUAL "CXX_COMPILER_VERSION")
        set(expected "${DockPipeDisplaySDK_COMPILER_VERSION}")
    else()
        set(expected "${DockPipeDisplaySDK_${field}}")
    endif()
    if(NOT "${CMAKE_${field}}" STREQUAL "${expected}")
        set(DockPipeDisplaySDK_FOUND FALSE)
        set(DockPipeDisplaySDK_NOT_FOUND_MESSAGE
            "Display SDK ${field} requires ${expected}; selected ${CMAKE_${field}}")
        return()
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/DockPipeDisplaySDKTargets.cmake")
check_required_components(DockPipeDisplaySDK)
