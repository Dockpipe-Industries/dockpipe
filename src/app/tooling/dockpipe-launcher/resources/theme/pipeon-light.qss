/* Quiet, consistent controls across platforms. */
QWidget#executionExplorerPage { background: #f3f5f9; }
QFrame#systemMetricCard { background: #ffffff; border: 1px solid #cdd4df; border-radius: 8px; }
QFrame#systemMetricCard QLabel { background: transparent; border: none; }
QLabel#systemMetricTitle { color: #53657c; }
QFrame#systemMetricCard QProgressBar { background: #e2e9f2; border: none; border-radius: 4px; }
QFrame#systemMetricCard QProgressBar::chunk { background: #307bbd; border-radius: 4px; }
QDialog { background-color: #f7f8fb; }
QPushButton { background-color: #ffffff; border-color: #cdd4df; color: #263449; }
QPushButton:hover { background-color: #edf2f8; border-color: #9aabbe; }
QPushButton:pressed { background-color: #e4ebf4; }
QPushButton:disabled { background-color: #f7f8fb; border-color: #cdd4df; color: #8993a1; }
QWidget#studioInspector, QWidget#studioSidebar,
QScrollArea#studioInspectorScroll, QScrollArea#studioInspectorScroll > QWidget { background: #f7f8fb; }
QWidget#workflowStudio QPlainTextEdit { background: #ffffff; border-color: #cdd4df; }
QWidget#projectFiles, QWidget#projectGit { background: #f4f6fa; }
QWidget#projectFiles QPlainTextEdit, QWidget#projectGit QPlainTextEdit { background: #ffffff; color: #263343; border-color: #cdd4df; }
QWidget#projectFiles QTreeView, QWidget#projectGit QListWidget { background: #f4f6fa; color: #263343; border: none; }
QPushButton#applyStep { background: #e9f2fc; border-color: #bdd4ed; }

/* Explicit foregrounds keep scheme changes independent of Qt's cached widget palettes. */
QWidget {
    color: #25344a;
}

QWidget:disabled {
    color: #8993a1;
}

QPushButton#primaryButton {
    color: #ffffff;
}

/* Light UI — high contrast for secondary text and badges (WCAG-friendly on white/near-white) */

QLabel#appSubtitle,
QLabel#hintText,
QLabel#contextPath,
QLabel#contextMeta,
QLabel#consoleMeta,
QLabel#emptyBody,
QLabel#logViewerStatus,
QLabel#logViewerPath {
    color: #2d2d2d;
}

QLabel#logViewerCommand {
    color: #141414;
}

QLabel#promptEyebrow,
QLabel#promptHint {
    color: #35547a;
}

QLabel#emptyTitle {
    color: #141414;
}

QDialog {
    color: #1e2430;
}

QLabel#statusBadge[status="running"] {
    background-color: #a5d6a7;
    color: #0a3d14;
}

QLabel#statusBadge[status="stopped"] {
    background-color: #e6edf5;
    color: #3c526d;
}

QLabel#statusBadge[status="failed"] {
    background-color: #ffcdd2;
    color: #5c0000;
}

QDialog#packageManagerDialog, QDialog#packageManagerDialog QTextBrowser {
    background-color: #f6f8fc;
    color: #263449;
}

QDialog#packageManagerDialog QPushButton {
    background-color: #edf1f7;
    color: #263449;
    border: 1px solid #c4cddd;
    border-radius: 7px;
    padding: 7px 14px;
}

QDialog#packageManagerDialog QPushButton:disabled {
    color: #7b8799;
}

QPushButton#installRemoteProvider,
QPushButton#secondaryButton {
    color: #1f1f1f;
    border: 1px solid #9a9a9a;
}

QPushButton#installRemoteProvider:hover,
QPushButton#secondaryButton:hover {
    background-color: #dedede;
    color: #0a0a0a;
}

QPushButton#primaryButton {
    background-color: #0d6fd1;
    border-color: #0d6fd1;
}

QPushButton#primaryButton:hover {
    background-color: #1b7fe3;
    border-color: #1b7fe3;
}

QPushButton#dangerButton {
    color: #5c0a0a;
    border: 1px solid #b71c1c;
    background-color: rgba(183, 28, 28, 0.1);
}

QPushButton#dangerButton:hover {
    background-color: rgba(183, 28, 28, 0.18);
    color: #3d0606;
}

QLabel#disclaimerWatermark {
    color: #5c5c5c;
}

QToolTip,
QMenu {
    background-color: #ffffff;
    color: #1b2230;
    border: 1px solid #d3d7de;
}

QMenuBar {
    background-color: #f6f8fb;
    color: #1b2230;
    border-bottom: 1px solid #dbe1e8;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: rgba(13, 111, 209, 0.10);
}

QMenu::separator {
    background: #d3d7de;
}

QStatusBar {
    border-top: 1px solid #c8c8c8;
}

QFrame#basicHero,
QFrame#projectSummary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ffffff, stop:1 #f3f7fb);
    border: 1px solid #d9e1ea;
}

QFrame#surfacePanel {
    background-color: #ffffff;
    border: 1px solid #d3d7de;
}

QFrame#inlineConsolePanel {
    background-color: #f5f6f8;
    border: 1px solid #d3d7de;
}

QFrame#headerBar,
QFrame#listPanel,
QFrame#emptyState,
QFrame#dockerHero {
    border: 1px solid #d3d7de;
}

QWidget#launchOverlay {
    background-color: rgba(244, 247, 251, 0.78);
}

QFrame#launchOverlayCard {
    background-color: #ffffff;
    border: 1px solid #d3d7de;
}

QFrame#promptDialogCard {
    background-color: #ffffff;
    border: 1px solid #d3d7de;
}

QFrame#promptActionPanel {
    background-color: #f5f7fb;
    border: 1px solid #d3d7de;
}

QListWidget::item:hover {
    background-color: rgba(13, 111, 209, 0.08);
}

QListWidget::item:selected,
QListWidget::item:selected:hover {
    background-color: rgba(13, 111, 209, 0.14);
}

QPlainTextEdit#inlineConsole {
    background-color: #fbfcfe;
    color: #1b2230;
    border-color: #c4cad4;
}

QPlainTextEdit#detailConsole,
QTextBrowser#detailBrowser,
QLineEdit,
QComboBox {
    background-color: #fbfcfe;
    color: #1b2230;
    border-color: #c4cad4;
}

QLineEdit#promptInput {
    background-color: #fbfcfe;
    color: #1b2230;
    border: 1px solid #c4cad4;
}

QLineEdit#surfaceSearch {
    background-color: #ffffff;
    border: 1px solid #cfd7e2;
}

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f5f7fb;
    border: 1px solid #d3d7de;
    gridline-color: transparent;
}

QTableWidget::item:selected {
    background-color: rgba(13, 111, 209, 0.16);
}

QLabel#dockerMetric {
    padding: 8px 12px;
    border-radius: 10px;
    background-color: #eef2f7;
    border: 1px solid #d3d7de;
    color: #1b2230;
    font-weight: 600;
}

QLabel#dockerStatusPill {
    padding: 4px 10px;
    border-radius: 10px;
    font-weight: 700;
}

QLabel#dockerStatusPill[state="healthy"] {
    background-color: #d8f3dc;
    color: #0f5132;
}

QLabel#dockerStatusPill[state="running"] {
    background-color: #d7ebff;
    color: #0b5394;
}

QLabel#dockerStatusPill[state="paused"] {
    background-color: #fff1d6;
    color: #8a5300;
}

QLabel#dockerStatusPill[state="restarting"] {
    background-color: #f0e1ff;
    color: #6d28a8;
}

QLabel#dockerStatusPill[state="exited"],
QLabel#dockerStatusPill[state="created"],
QLabel#dockerStatusPill[state="other"] {
    background-color: #e8ecf1;
    color: #374151;
}

QMenu#dockerContextMenu {
    background-color: #ffffff;
    color: #1b2230;
    border: 1px solid #d3d7de;
    border-radius: 12px;
    padding: 8px;
}

QMenu#dockerContextMenu::item {
    border-radius: 8px;
    padding: 8px 16px 8px 12px;
    margin: 2px 0;
}

QMenu#dockerContextMenu::item:selected {
    background-color: rgba(13, 111, 209, 0.12);
}

QMenu#dockerContextMenu::separator {
    height: 1px;
    background: #d3d7de;
    margin: 8px 4px;
}

QHeaderView::section {
    background-color: #eef2f7;
    color: #1b2230;
    border: 0;
    border-bottom: 1px solid #d3d7de;
    padding: 8px 10px;
}

QTabWidget::pane,
QTabWidget#surfaceTabs::pane {
    border-color: #d3d7de;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #eef2f7;
    color: #1b2230;
}

QTabBar::tab:selected {
    background-color: #e6eef9;
    border-color: #bacde5;
    color: #284c79;
}

QTabBar::tab:hover:!selected {
    background-color: #dde5ef;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #c8d1dc;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #aeb9c8;
}

QWidget#mainCentral, QWidget#basicHomePage, QWidget#basicWorkspacePage, QWidget#basicAppsPage,
QWidget#machineContent {
    background: #f7f8fb;
}

QFrame#navigationRail {
    background: #edf0f5;
    border-right: 1px solid #dce1e9;
}

QFrame#workspaceBar {
    background: #f7f8fb;
    border-bottom-color: #dce1e9;
}

QLabel#eyebrow, QLabel#workspacePath, QLabel#cardDescription {
    color: #5e6b7e;
}

QPushButton#workspaceSelector {
    background: #e8edf5;
    color: #25344a;
    border: none;
}

QListWidget#workspaceNavigation::item {
    color: #536176;
}

QListWidget#workspaceNavigation::item:selected {
    background: #dce9fb;
    color: #18559f;
}

QListWidget#workspaceNavigation::item:hover {
    background: #e1e7f0;
}

QFrame#navigationRail QPushButton {
    background: transparent;
    color: #536176;
}

QFrame#navigationRail QPushButton:hover {
    background: #dce9fb;
    color: #18559f;
}

QFrame#appCard {
    background: #ffffff;
    border-color: #dce2eb;
}

QFrame#appCard:hover {
    border-color: #93abc9;
    background: #fafcff;
}

QLabel#cardTitle {
    color: #243247;
}

QLabel#cardStatus {
    background: #dff3e8;
    color: #256147;
}

QPushButton#remoteSetupNavigation, QPushButton#reviewRemoteSetup, QPushButton#checkRemoteConnection, QPushButton#quietButton {
    background: transparent;
    color: #5e6b7e;
}

QPushButton#remoteSetupNavigation:hover, QPushButton#reviewRemoteSetup:hover, QPushButton#checkRemoteConnection:hover, QPushButton#quietButton:hover {
    background: #e8edf5;
    color: #25344a;
}

QPushButton#cardLaunchButton {
    background: #e5efff;
    color: #1d579c;
}

QPushButton#cardLaunchButton:hover {
    background: #d0e3ff;
    color: #164579;
}

QPushButton#cardLaunchButton:disabled {
    background: #edf0f4;
    color: #8a94a4;
}

QScrollArea#machineScroll QScrollBar {
    background: #f7f8fb;
}

QPushButton#primaryButton:disabled {
    background: #e4e9f0;
    border-color: #e4e9f0;
    color: #8591a2;
}

QPushButton#installRemoteProvider:disabled,
QPushButton#secondaryButton:disabled,
QPushButton#remoteSetupNavigation:disabled, QPushButton#reviewRemoteSetup:disabled, QPushButton#checkRemoteConnection:disabled, QPushButton#quietButton:disabled {
    color: #8591a2;
    background: transparent;
}

QFrame[canvasOverlay="true"] { background: #ffffff; border: 1px solid #d3dae5; border-radius: 10px; }
QFrame[canvasOverlay="true"] QLabel { background: transparent; border: none; }
QFrame#canvasDocumentControls QPushButton, QFrame#canvasViewControls QPushButton { background: transparent; border: none; }
QFrame#canvasDocumentControls QPushButton:hover, QFrame#canvasViewControls QPushButton:hover { background: #d3dae5; }

QFrame[canvasOverlay="true"] { background: #ffffff; border-color: #cdd6e3; }
QFrame#canvasDocumentControls QPushButton:hover,
QFrame#canvasViewControls QPushButton:hover { background: #edf2f8; }
QFrame#canvasViewControls QPushButton:checked { background: #e0f1ec; border: 1px solid #8fbeb0; }
QFrame#canvasViewControls QPushButton:disabled { background: transparent; border: none; }
QFrame#canvasControlDivider { background: #dce3ec; border: none; }
QFrame[canvasWindow="true"] { border-color: #b9c8db; }
QMenu { background: #ffffff; border: 1px solid #ccd5e1; color: #28394f; }
QMenu::item:selected { background: #e8eff9; }
QMenu::separator { background: #dce3ec; }

QDialog[launcherChrome="true"] { background: #fafbfd; border: 1px solid #c9d3e1; }
QLabel#dialogHeading { color: #243449; }
QToolButton#windowControl:hover { background: #e5ebf3; }
QToolButton#windowControl:pressed { background: #d2dce9; }
QDialog QPushButton:default, QDialog QPushButton[dialogPrimary="true"] {
    background: #126dce; border: 1px solid #126dce; color: #ffffff;
}
QDialog QPushButton:default:hover, QDialog QPushButton[dialogPrimary="true"]:hover { background: #0d60b8; }
QDialog QPushButton:disabled { background: #edf1f6; color: #929fb0; border-color: #d6deea; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #bdc8d8; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #98a8be; }

ResourceCanvas QGraphicsView { background: #f6f8fc; }
QWidget#resourceDetailContent { background: #fafbfd; }
QFrame#workflowPreviewPanel { background: #edf2f8; border: 1px solid #d5dfeb; border-radius: 12px; }
QScrollArea#workflowPreviewScroll, QLabel#workflowPreview { background: #edf2f8; border: none; }

QPushButton[canvasLayerFilter="true"] { background: #f7f9fc; color: #63768c; border: 1px solid #ced9e6; padding: 6px 10px; }
QPushButton[canvasLayerFilter="true"]:checked { background: #e0edf9; color: #244c72; border-color: #9cbdda; }

QPlainTextEdit#dockerSelectedLogs { background: #ffffff; color: #28384c; border: 1px solid #cdd7e5; border-radius: 10px; padding: 10px; }
QScrollArea#dockerDetailsScroll, QLabel#dockerReadableDetails { background: #ffffff; color: #28384c; border: none; }

QWidget#runHistoryPage {
    background: #f6f8fc;
}
QLabel#runCount, QLabel#runStatus {
    color: #63768c;
}
QWidget#runHistoryPage QTableWidget {
    background: #ffffff;
    alternate-background-color: #edf2f8;
    color: #28384c;
    selection-background-color: #e0edf9;
    selection-color: #244c72;
}

/* Shared project/workflow editor and source control. */
QWidget#editorWorkspace { background: #ffffff; border: 1px solid #d7e0e9; border-radius: 10px; }
QWidget#projectFiles QPlainTextEdit { border: none; border-radius: 0px; }
QLabel#editorSectionLabel { color: #61738a; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
QLabel#editorMuted, QLabel#editorStatus { color: #61738a; font-size: 11px; }
QLabel#editorEmptyTitle { color: #25374a; font-size: 20px; font-weight: 600; }
QToolButton#editorIconButton { background: transparent; border: none; border-radius: 6px; padding: 6px; }
QToolButton#editorIconButton:hover { background: #f0f5fa; }
QToolButton#editorIconButton::menu-indicator { image: none; }
QTreeView#fileTree { outline: none; padding: 2px; }
QTreeView#fileTree::item { height: 30px; padding: 0px 6px; border-radius: 5px; }
QTreeView#fileTree::item:hover { background: #f0f5fa; }
QTreeView#fileTree::item:selected { background: #dceef7; color: #25374a; }
QPushButton#editorSave { padding: 6px 14px; min-height: 18px; }
QLabel#gitHeading { font-size: 22px; font-weight: 600; }
QLabel#gitBranch { color: #25374a; background: #f0f5fa; border: 1px solid #d7e0e9; border-radius: 6px; padding: 7px 12px; }
QListWidget#gitChangedFiles { outline: none; }
QListWidget#gitChangedFiles::item { border-radius: 6px; }
QWidget#gitCommitPanel { background: #ffffff; border: 1px solid #d7e0e9; border-radius: 8px; }
