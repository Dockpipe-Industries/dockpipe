/* Dockpipe Launcher shared layout. Color accents live in pipeon-light.qss / pipeon-dark.qss. */

QWidget#mainCentral,
QWidget#basicHomePage,
QWidget#basicWorkspacePage,
QWidget#basicAppsPage,
QDialog {
    background-color: palette(base);
}

QToolTip {
    border-radius: 10px;
    padding: 8px 10px;
}

QMenuBar {
    padding: 6px 10px 4px 10px;
}

QMenuBar::item {
    padding: 6px 10px;
    border-radius: 8px;
    margin-right: 2px;
}

QMenu {
    border-radius: 14px;
    padding: 8px;
}

QMenu::item {
    padding: 8px 16px 8px 12px;
    border-radius: 9px;
    margin: 2px 0;
}

QMenu::separator {
    height: 1px;
    margin: 8px 4px;
}

QStatusBar {
    background: transparent;
}

QLabel#appTitle {
    font-size: 22px;
    font-weight: 700;
}

QLabel#sectionTitle {
    font-size: 14px;
    font-weight: 700;
}

QLabel#appSubtitle {
    font-size: 13px;
    line-height: 1.5;
}

QLabel#hintText {
    font-size: 12px;
    line-height: 1.45;
}

QLabel#disclaimerWatermark {
    font-size: 11px;
    font-style: italic;
    padding: 4px 10px 6px 10px;
}

QPushButton#disclaimerDismiss {
    font-size: 11px;
    padding: 4px 10px;
    min-height: 24px;
}

QFrame#basicHero,
QFrame#headerBar,
QFrame#dockerHero {
    border: none;
    border-radius: 12px;
    padding: 6px;
}

QFrame#surfacePanel,
QFrame#projectSummary,
QFrame#listPanel,
QFrame#inlineConsolePanel,
QFrame#emptyState,
QFrame#launchOverlayCard,
QFrame#promptDialogCard,
QFrame#promptActionPanel {
    border-radius: 12px;
}

QWidget#launchOverlay {
    border-radius: 22px;
}

QLabel#promptEyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QLabel#promptTitle {
    font-size: 24px;
    font-weight: 700;
}

QLabel#promptBody {
    font-size: 13px;
    line-height: 1.55;
}

QLabel#promptHint {
    font-size: 12px;
}

QLineEdit#promptInput {
    min-height: 40px;
    border-radius: 13px;
    padding: 8px 12px;
    font-size: 13px;
}

QLabel#launchOverlayGlyph {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 2px;
    color: palette(highlight);
    padding: 2px 0 6px 0;
}

QLabel#launchOverlayTitle {
    font-size: 21px;
    font-weight: 700;
}

QLabel#launchOverlayBody {
    font-size: 13px;
    font-weight: 500;
    padding: 2px 8px 0 8px;
    qproperty-wordWrap: true;
}

QSplitter::handle {
    background: transparent;
}

QSplitter::handle:vertical {
    height: 12px;
}

QSplitter::handle:horizontal {
    width: 12px;
}

QSplitter::handle:hover {
    border-radius: 6px;
}

QListWidget,
QTableWidget {
    outline: none;
}

QListWidget {
    border: none;
    background: transparent;
    padding: 6px;
}

QListWidget::item {
    border: none;
    border-radius: 16px;
    margin: 4px 4px;
    padding: 0px;
    background: transparent;
}

QListWidget#basicAppList::item {
    min-height: 76px;
}

QListWidget::item:selected {
    background-color: palette(highlight);
}

QListWidget#basicRecentList {
    padding: 2px;
}

QListWidget#basicRecentList::item {
    margin: 0 2px;
    padding: 10px 12px;
    min-height: 28px;
}

QWidget#contextRow {
    background-color: transparent;
    border-radius: 14px;
}

QLabel#contextTitle {
    font-size: 13px;
    font-weight: 700;
}

QLabel#contextPath {
    font-size: 11px;
}

QLabel#contextMeta,
QLabel#consoleMeta {
    font-size: 11px;
}

QLabel#consoleTitle {
    font-size: 14px;
    font-weight: 700;
}

QLabel#statusBadge {
    min-width: 56px;
    padding: 5px 11px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
}

QGroupBox {
    font-weight: 600;
    border: none;
    border-radius: 14px;
    margin-top: 10px;
    padding: 14px 14px 12px 14px;
    background-color: palette(alternate-base);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
}

/* Shared controls should not fall back to tiny platform-native bevel buttons. */
QPushButton {
    min-height: 26px;
    padding: 5px 12px;
    border: 1px solid palette(midlight);
    border-radius: 8px;
    font-weight: 500;
}

QPushButton:focus {
    border: 1px solid palette(highlight);
}

QPushButton#primaryButton,
QPushButton#installRemoteProvider,
QPushButton#secondaryButton,
QPushButton#dangerButton {
    min-height: 26px;
    border-radius: 8px;
    font-weight: 600;
}

QPushButton#primaryButton {
    padding: 10px 18px;
    border: 1px solid palette(highlight);
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QPushButton#primaryButton:pressed {
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton#installRemoteProvider,
QPushButton#secondaryButton,
QPushButton#dangerButton {
    padding: 10px 14px;
}

QLineEdit,
QComboBox,
QTextBrowser,
QPlainTextEdit,
QTableWidget,
QAbstractScrollArea {
    border-radius: 8px;
}

QLineEdit,
QComboBox,
QTextBrowser,
QPlainTextEdit {
    padding: 8px 11px;
    border: 1px solid palette(midlight);
    background-color: palette(base);
    color: palette(text);
    min-height: 18px;
}

QLineEdit#surfaceSearch {
    min-height: 38px;
    padding: 8px 12px;
}

QLineEdit:focus,
QComboBox:focus,
QTextBrowser:focus,
QPlainTextEdit:focus {
    border: 1px solid palette(highlight);
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QPlainTextEdit#inlineConsole {
    border-radius: 14px;
    padding: 12px 14px;
    border: 1px solid palette(midlight);
    selection-background-color: palette(highlight);
    font-size: 12px;
}

QPlainTextEdit#detailConsole,
QTextBrowser#detailBrowser {
    border-radius: 14px;
    padding: 12px 14px;
    selection-background-color: palette(highlight);
}

QToolButton#toggleSidebarButton {
    border: none;
    border-radius: 6px;
    padding: 0;
    background: transparent;
}

QToolButton#toggleSidebarButton:hover {
    background: palette(midlight);
}

QTabWidget#executionTabs::pane {
    border: none;
}

QTabWidget#executionTabs QTabBar::tab {
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    background: transparent;
    padding: 14px 20px;
    margin: 0 4px;
}

QTabWidget#executionTabs QTabBar::tab:selected {
    border-bottom: 2px solid palette(highlight);
    background: transparent;
}

QLabel#runEmptyTitle {
    font-size: 22px;
    font-weight: 600;
}

QWidget#runHistoryPage QTableWidget {
    border: none;
    border-radius: 8px;
}

QFrame#emptyState {
    border: none;
}

QLabel#emptyTitle {
    font-size: 16px;
    font-weight: 700;
}

QLabel#emptyBody {
    font-size: 12px;
    line-height: 1.45;
}

QTabWidget#surfaceTabs::pane,
QTabWidget::pane {
    border: 1px solid palette(midlight);
    border-radius: 12px;
    top: -1px;
    background: palette(base);
}

QTabBar::tab {
    border: 1px solid transparent;
    padding: 9px 15px;
    margin-right: 6px;
    border-radius: 7px;
    background: palette(alternate-base);
    font-weight: 600;
}

QHeaderView::section {
    font-weight: 600;
}

QTableWidget {
    selection-background-color: palette(highlight);
    border: 1px solid palette(midlight);
}

QScrollBar:vertical {
    width: 12px;
    margin: 6px 4px 6px 0;
}

QScrollBar:horizontal {
    height: 12px;
    margin: 0 6px 4px 6px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    min-height: 28px;
    min-width: 28px;
    border-radius: 4px;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    border: none;
    background: transparent;
}

/* Workspace shell and app library */
QFrame#workspaceBar {
    border-bottom: 1px solid palette(mid);
}

QLabel#eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#workspacePath {
    font-size: 12px;
}

QListWidget#workspaceNavigation {
    border: none;
    padding: 12px 0;
}

QListWidget#workspaceNavigation::item {
    margin: 0;
    padding: 0 14px;
    border-radius: 8px;
}

QFrame#navigationRail QPushButton {
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-radius: 8px;
}

QPushButton#workspaceSelector {
    padding: 8px 28px 8px 12px;
    border-radius: 7px;
    font-weight: 600;
}

QPushButton#workspaceSelector::menu-indicator {
    subcontrol-position: right center;
    right: 10px;
}

QListWidget#basicAppList {
    border: none;
    padding: 0;
}

QListWidget#basicAppList::item {
    margin: 0;
    padding: 0;
    border-radius: 12px;
}

QFrame#appCard {
    border: 1px solid palette(mid);
    border-radius: 12px;
}

QLabel#cardTitle {
    font-size: 15px;
    font-weight: 600;
}

QLabel#cardDescription {
    font-size: 12px;
}

QLabel#cardStatus {
    font-size: 10px;
    font-weight: 600;
    padding: 3px 6px;
    border-radius: 5px;
}

QPushButton#remoteSetupNavigation, QPushButton#reviewRemoteSetup, QPushButton#checkRemoteConnection, QPushButton#quietButton, QPushButton#cardLaunchButton {
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 7px 10px;
    min-height: 20px;
}

QPushButton#cardLaunchButton {
    font-weight: 600;
}

QPushButton#remoteSetupNavigation:focus, QPushButton#reviewRemoteSetup:focus, QPushButton#checkRemoteConnection:focus, QPushButton#quietButton:focus, QPushButton#cardLaunchButton:focus {
    border-color: #508cca;
}

QWidget#appsEmptyState QLabel#emptyTitle {
    font-size: 20px;
    font-weight: 600;
}

QScrollArea#machineScroll {
    background: transparent;
    border: none;
}

QScrollArea#machineScroll QScrollBar::handle:vertical {
    min-width: 0;
    min-height: 28px;
    border-radius: 4px;
}

QScrollArea#machineScroll QScrollBar::add-line:vertical,
QScrollArea#machineScroll QScrollBar::sub-line:vertical {
    height: 0;
}

/* Studio toolbar and inspector share the launcher's spacing and state language. */
QWidget#workflowStudio QPushButton {
    min-height: 28px;
}
QWidget#workflowStudio QPushButton#primaryButton {
    padding: 7px 16px;
}
QWidget#studioInspector QLabel#sectionTitle {
    font-size: 11px;
    letter-spacing: 1px;
}
QWidget#studioInspector QLineEdit,
QWidget#studioInspector QComboBox {
    padding: 6px 10px;
}
QWidget#studioInspector QPlainTextEdit {
    padding: 8px 10px;
}
QPushButton#applyStep {
    font-weight: 600;
}

/* Canvas workspace: compact chrome leaves the graph as the primary surface. */
QLabel#studioFilename { font-weight: 600; padding: 0 6px; }
QFrame#workflowCanvasBar QPushButton, QFrame#workflowTerminalPanel QPushButton {
    padding: 5px 10px;
    min-height: 22px;
}
QFrame#workflowCanvasBar { border-top: 1px solid palette(mid); }
QFrame#workflowTerminalPanel { border-top: 1px solid palette(mid); }
QWidget#workflowStudio QTabWidget::pane { border: none; }
QWidget#workflowStudio QGraphicsView { border: none; border-radius: 0; }

QFrame#canvasDocumentControls QPushButton, QFrame#canvasRunControls QPushButton,
QFrame#canvasViewControls QPushButton {
    padding: 4px 8px;
    min-height: 24px;
    border-radius: 6px;
}
QFrame#canvasViewControls QPushButton { padding: 0; font-size: 16px; }
QFrame#canvasDocumentControls QPushButton::menu-indicator { width: 0; }
QPlainTextEdit#workflowYaml { padding: 76px 24px 70px 24px; }
QTabWidget#canvasDocument::pane { border: 0; }

QPushButton#canvasCloseProperties { min-width: 0; min-height: 0; padding: 0; font-size: 18px; border: none; background: transparent; }

/* Canvas controls use one density, icon scale, and focus treatment. */
QFrame[canvasOverlay="true"] { border-radius: 12px; }
QFrame#canvasDocumentControls QPushButton,
QFrame#canvasRunControls QPushButton,
QFrame#workflowCanvasBar QPushButton {
    min-height: 28px;
    padding: 4px 10px;
    font-size: 12px;
    border-radius: 7px;
}
QFrame#canvasViewControls QPushButton { min-height: 34px; min-width: 34px; padding: 0; }
QFrame#canvasViewControls QPushButton#canvasZoomLevel {
    min-height: 24px;
    font-size: 10px;
    font-weight: 500;
}
QPushButton#canvasMoreButton, QPushButton#workflowShortcuts { padding: 4px; min-width: 24px; }
QWidget#workflowStudio QPushButton:focus { border: 1px solid #64adce; }
QMenu { padding: 6px; border-radius: 9px; }
QMenu::item { padding: 9px 26px 9px 30px; border-radius: 5px; }
QMenu::icon { padding-left: 5px; }
QMenu::separator { height: 1px; margin: 5px 8px; }

/* Shared application window chrome and dialog rhythm. */
QDialog[launcherChrome="true"] { border-radius: 14px; }
QLabel#dialogHeading { font-size: 19px; font-weight: 600; background: transparent; }
QWidget#dialogHeader { background: transparent; }
QToolButton#windowControl, QToolButton#windowClose {
    border: none;
    border-radius: 6px;
    padding: 0;
    min-width: 36px;
    min-height: 32px;
    background: transparent;
}
QToolButton#windowControl:focus, QToolButton#windowClose:focus { border: 1px solid #64adce; }
QToolButton#windowClose:hover { background: #c74550; }
QToolButton#windowClose:pressed { background: #a83340; }
QDialog QPushButton { padding: 8px 16px; min-height: 20px; border-radius: 8px; }
QDialogButtonBox { dialogbuttonbox-buttons-have-icons: 0; }
QDialog QDialogButtonBox { margin-top: 8px; }
QDialog QLabel#qt_msgbox_label { font-size: 14px; line-height: 1.5; }
QDialog QLabel#qt_msgbox_informativelabel { font-size: 12px; }
QDialog#workflowPicker QLineEdit#surfaceSearch { padding: 12px 16px; min-height: 22px; }
QDialog#workflowPicker QFrame#listPanel { border: none; }
QDialog#workflowPicker QListWidget { padding: 4px; border: none; }
QScrollBar:vertical { width: 10px; margin: 4px 2px; background: transparent; }
QScrollBar:horizontal { height: 10px; margin: 2px 4px; background: transparent; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::up-arrow, QScrollBar::down-arrow,
QScrollBar::left-arrow, QScrollBar::right-arrow { width: 0; height: 0; background: none; }
QScrollBar::handle:vertical { min-height: 32px; min-width: 0; border-radius: 3px; }
QScrollBar::handle:horizontal { min-width: 32px; min-height: 0; border-radius: 3px; }
