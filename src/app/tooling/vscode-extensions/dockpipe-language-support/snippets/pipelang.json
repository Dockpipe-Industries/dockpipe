{
  "PipeLang Interface": {
    "prefix": "pipe-interface",
    "body": [
      "public Interface ${1:IConfig}",
      "{",
      "    public string ${2:NAME};",
      "}"
    ],
    "description": "Create a PipeLang interface."
  },
  "PipeLang Class": {
    "prefix": "pipe-class",
    "body": [
      "public Class ${1:Config} : ${2:IConfig}",
      "{",
      "    public string ${3:NAME} = \"${4:value}\";",
      "}"
    ],
    "description": "Create a PipeLang class implementing an interface."
  },
  "PipeLang Struct": {
    "prefix": "pipe-struct",
    "body": [
      "public Struct ${1:KnownValues}",
      "{",
      "    public string ${2:KEY} = \"${3:value}\";",
      "}"
    ],
    "description": "Create a PipeLang struct."
  },
  "PipeLang Record": {
    "prefix": "pipe-record",
    "body": [
      "public Record ${1:Row}",
      "{",
      "    public string ${2:Id};",
      "    public int ${3:Count};",
      "}"
    ],
    "description": "Create a v0.9.0 PipeLang primitive immutable record."
  },
  "PipeLang Record Field Projection": {
    "prefix": "pipe-record-field",
    "body": [
      "public ${1:string} ${2:IdOf}(${3:Row} ${4:value}) => ${4:value}.${5:Id};"
    ],
    "description": "Create a v0.10.0 one-hop read-only primitive-record field projection."
  },
  "PipeLang Record Construction": {
    "prefix": "pipe-record-new",
    "body": [
      "public ${1:Row} ${2:Create}(${3:string} ${4:id}) =>",
      "    new ${1:Row} { ${5:Id} = ${4:id} };"
    ],
    "description": "Create an exact v0.11.0 declaration-ordered primitive-record construction."
  },
  "PipeLang Record Equality": {
    "prefix": "pipe-record-equality",
    "body": [
      "public bool ${1:Same}(${2:Row} ${3:left}, ${2:Row} ${4:right}) => ${3:left} ${5|==,!=|} ${4:right};"
    ],
    "description": "Create an exact v0.12.0 direct structural primitive-record equality method."
  }
}
