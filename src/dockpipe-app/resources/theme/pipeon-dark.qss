/* Quiet, consistent controls across platforms. */
QWidget#executionExplorerPage { background: #141920; }
QFrame#systemMetricCard { background: #1d232d; border: 1px solid #363f4c; border-radius: 8px; }
QFrame#systemMetricCard QLabel { background: transparent; border: none; }
QLabel#systemMetricTitle { color: #a8b9ce; }
QFrame#systemMetricCard QProgressBar { background: #303a48; border: none; border-radius: 4px; }
QFrame#systemMetricCard QProgressBar::chunk { background: #75b5ec; border-radius: 4px; }
QDialog { background-color: #191d24; }
QPushButton { background-color: #242b36; border-color: #363f4c; color: #dce4ee; }
QPushButton:hover { background-color: #303a48; border-color: #586779; }
QPushButton:pressed { background-color: #1d2530; }
QPushButton#dashboardCanvasMode:checked, QPushButton#dashboardTilingMode:checked {
    background-color: #263e3b; border-color: #3c6158; color: #b7eadb;
}
QPushButton:disabled { background-color: #191d24; border-color: #363f4c; color: #7f8a99; }
QWidget#studioInspector, QWidget#studioSidebar,
QScrollArea#studioInspectorScroll, QScrollArea#studioInspectorScroll > QWidget { background: #191d24; }
QWidget#workflowStudio QPlainTextEdit { background: #141920; border-color: #363f4c; }
QWidget#projectFiles, QWidget#projectGit { background: #191d24; }
QWidget#projectFiles QPlainTextEdit, QWidget#projectGit QPlainTextEdit { background: #141920; color: #dce5f0; border-color: #363f4c; }
QWidget#projectFiles QTreeView, QWidget#projectGit QListWidget { background: #191d24; color: #dce5f0; border: none; }
QPushButton#applyStep { background: #263c50; border-color: #3d5a75; }

/* Explicit foregrounds keep scheme changes independent of Qt's cached widget palettes. */
QWidget {
    color: #e7ebf2;
}

QWidget:disabled {
    color: #858e9c;
}

QPushButton#primaryButton {
    color: #ffffff;
}

/* Dark UI — muted text bright enough on dark surfaces */

QLabel#appSubtitle,
QLabel#hintText,
QLabel#contextPath,
QLabel#contextMeta,
QLabel#consoleMeta,
QLabel#emptyBody,
QLabel#logViewerStatus,
QLabel#logViewerPath {
    color: #c8c8c8;
}

QLabel#logViewerCommand {
    color: #e4e8ef;
}

QLabel#promptEyebrow,
QLabel#promptHint {
    color: #9fb4d1;
}

QLabel#emptyTitle {
    color: #f2f2f2;
}

QDialog {
    color: #e7ebf2;
}

QLabel#statusBadge[status="running"] {
    background-color: rgba(46, 160, 67, 0.28);
    color: #8ef0b0;
}

QLabel#statusBadge[status="stopped"] {
    background-color: #283341;
    color: #c4d1e0;
}

QLabel#statusBadge[status="failed"] {
    background-color: rgba(248, 81, 73, 0.22);
    color: #ffb4ae;
}

QDialog#packageManagerDialog, QDialog#packageManagerDialog QTextBrowser {
    background-color: #191e26;
    color: #e3e8f0;
}

QDialog#packageManagerDialog QPushButton {
    background-color: #2b323d;
    color: #e3e8f0;
    border: 1px solid #3c4655;
    border-radius: 7px;
    padding: 7px 14px;
}

QDialog#packageManagerDialog QPushButton:disabled {
    color: #8c98a8;
}

QPushButton#installRemoteProvider,
QPushButton#secondaryButton {
    color: #ececec;
}

QPushButton#installRemoteProvider:hover,
QPushButton#secondaryButton:hover {
    background-color: #4a4a4a;
    color: #ffffff;
}

QPushButton#primaryButton {
    background-color: #1f7dd9;
    border-color: #1f7dd9;
}

QPushButton#primaryButton:hover {
    background-color: #2b8cf0;
    border-color: #2b8cf0;
}

QPushButton#dangerButton {
    color: #ffcdd2;
    border: 1px solid rgba(248, 81, 73, 0.55);
    background-color: rgba(248, 81, 73, 0.14);
}

QPushButton#dangerButton:hover {
    background-color: rgba(248, 81, 73, 0.24);
    color: #ffffff;
}

QLabel#disclaimerWatermark {
    color: #8a8a8a;
}

QToolTip,
QMenu {
    background-color: #1c2128;
    color: #e7ebf2;
    border: 1px solid #343841;
}

QMenuBar {
    background-color: #171b21;
    color: #e7ebf2;
    border-bottom: 1px solid #2c3139;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: rgba(31, 125, 217, 0.22);
}

QMenu::separator {
    background: #343841;
}

QStatusBar {
    border-top: 1px solid #3a3a3a;
}

QFrame#basicHero,
QFrame#projectSummary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #20252d, stop:1 #171b21);
    border: 1px solid #343841;
}

QFrame#surfacePanel {
    background-color: #1b1f26;
    border: 1px solid #343841;
}

QFrame#inlineConsolePanel {
    background-color: #26282c;
    border: 1px solid #343841;
}

QFrame#headerBar,
QFrame#listPanel,
QFrame#emptyState {
    border: 1px solid #343841;
}

QWidget#launchOverlay {
    background-color: rgba(15, 18, 23, 0.72);
}

QFrame#launchOverlayCard {
    background-color: #20242b;
    border: 1px solid #343841;
}

QFrame#promptDialogCard {
    background-color: #1f232a;
    border: 1px solid #343841;
}

QFrame#promptActionPanel {
    background-color: #262b33;
    border: 1px solid #343841;
}

QListWidget::item:hover {
    background-color: rgba(31, 125, 217, 0.12);
}

QListWidget::item:selected,
QListWidget::item:selected:hover {
    background-color: rgba(31, 125, 217, 0.22);
}

QPlainTextEdit#inlineConsole {
    background-color: #111317;
    color: #d7dde7;
    border-color: #343841;
}

QPlainTextEdit#detailConsole,
QTextBrowser#detailBrowser,
QLineEdit,
QComboBox {
    background-color: #171a1f;
    color: #d7dde7;
    border-color: #343841;
}

QLineEdit#promptInput {
    background-color: #171a1f;
    color: #d7dde7;
    border: 1px solid #343841;
}

QLineEdit#surfaceSearch {
    background-color: #171b21;
    border: 1px solid #343841;
}

QFrame#dockerHero {
    background-color: #26282c;
    border: 1px solid #343841;
    border-radius: 14px;
}

QLabel#dockerMetric {
    padding: 8px 12px;
    border-radius: 10px;
    background-color: #2f333b;
    border: 1px solid #3a404a;
    color: #e7ebf2;
    font-weight: 600;
}

QTableWidget#dockerTable {
    background-color: #1c1f24;
    alternate-background-color: #20242a;
    border: 1px solid #343841;
    gridline-color: transparent;
}

QTableWidget {
    background-color: #1c1f24;
    alternate-background-color: #20242a;
    border: 1px solid #343841;
    gridline-color: transparent;
}

QTableWidget#dockerTable::item {
    padding: 8px 10px;
}

QTableWidget::item:selected {
    background-color: rgba(31, 125, 217, 0.24);
}

QHeaderView::section {
    background-color: #2a2e35;
    color: #d7dde7;
    border: 0;
    border-bottom: 1px solid #3a404a;
    padding: 8px 10px;
}

QLabel#dockerStatusPill {
    padding: 4px 10px;
    border-radius: 10px;
    font-weight: 700;
}

QLabel#dockerStatusPill[state="healthy"] {
    background-color: rgba(46, 160, 67, 0.24);
    color: #8ef0b0;
}

QLabel#dockerStatusPill[state="running"] {
    background-color: rgba(27, 153, 255, 0.20);
    color: #7ed0ff;
}

QLabel#dockerStatusPill[state="paused"] {
    background-color: rgba(245, 158, 11, 0.22);
    color: #f6c56a;
}

QLabel#dockerStatusPill[state="restarting"] {
    background-color: rgba(168, 85, 247, 0.24);
    color: #d3adff;
}

QLabel#dockerStatusPill[state="exited"],
QLabel#dockerStatusPill[state="created"],
QLabel#dockerStatusPill[state="other"] {
    background-color: #353941;
    color: #d0d6df;
}

QMenu#dockerContextMenu {
    background-color: #20242b;
    color: #e7ebf2;
    border: 1px solid #343841;
    border-radius: 12px;
    padding: 8px;
}

QMenu#dockerContextMenu::item {
    border-radius: 8px;
    padding: 8px 16px 8px 12px;
    margin: 2px 0;
}

QMenu#dockerContextMenu::item:selected {
    background-color: rgba(31, 125, 217, 0.24);
}

QMenu#dockerContextMenu::separator {
    height: 1px;
    background: #343841;
    margin: 8px 4px;
}

QTabWidget::pane,
QTabWidget#surfaceTabs::pane {
    border-color: #343841;
    background-color: #1c1f24;
}

QTabBar::tab {
    background-color: #252930;
    color: #d7dde7;
}

QTabBar::tab:selected {
    background-color: #2a384b;
    border-color: #425b79;
    color: #e5efff;
}

QTabBar::tab:hover:!selected {
    background-color: #323741;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #414753;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #596274;
}

QWidget#mainCentral, QWidget#dashboardPage, QWidget#basicHomePage, QWidget#basicWorkspacePage, QWidget#basicAppsPage,
QWidget#machineContent {
    background: #191d24;
}

QFrame#navigationRail {
    background: #14181e;
    border-right: 1px solid #2b313b;
}

QFrame#workspaceBar {
    background: #191d24;
    border-bottom-color: #2b313b;
}

QLabel#eyebrow, QLabel#workspacePath, QLabel#cardDescription {
    color: #9faabb;
}

QPushButton#workspaceSelector {
    background: #252c37;
    color: #e7edf5;
    border: none;
}

QListWidget#workspaceNavigation::item {
    color: #adb7c6;
}

QListWidget#workspaceNavigation::item:selected {
    background: #243951;
    color: #e9f3ff;
}

QListWidget#workspaceNavigation::item:hover {
    background: #222c39;
}

QFrame#navigationRail QPushButton {
    background: transparent;
    color: #adb7c6;
}

QFrame#navigationRail QPushButton:hover {
    background: #222c39;
    color: #ffffff;
}

QFrame#appCard {
    background: #222832;
    border-color: #333d4b;
}

QFrame#appCard:hover {
    border-color: #526780;
    background: #252e3a;
}

QLabel#cardTitle {
    color: #edf2fa;
}

QLabel#cardStatus {
    background: #234236;
    color: #9bdfbd;
}

QPushButton#remoteSetupNavigation, QPushButton#reviewRemoteSetup, QPushButton#checkRemoteConnection, QPushButton#quietButton {
    background: transparent;
    color: #b6c1d1;
}

QPushButton#remoteSetupNavigation:hover, QPushButton#reviewRemoteSetup:hover, QPushButton#checkRemoteConnection:hover, QPushButton#quietButton:hover {
    background: #303b4b;
    color: #ffffff;
}

QPushButton#cardLaunchButton {
    background: #2b405b;
    color: #b9dcff;
}

QPushButton#cardLaunchButton:hover {
    background: #35567d;
    color: #ffffff;
}

QPushButton#cardLaunchButton:disabled {
    background: #2d323b;
    color: #8b95a5;
}

QScrollArea#machineScroll QScrollBar {
    background: #191d24;
}

QPushButton#primaryButton:disabled {
    background: #2b323d;
    border-color: #2b323d;
    color: #8b96a6;
}

QPushButton#installRemoteProvider:disabled,
QPushButton#secondaryButton:disabled,
QPushButton#remoteSetupNavigation:disabled, QPushButton#reviewRemoteSetup:disabled, QPushButton#checkRemoteConnection:disabled, QPushButton#quietButton:disabled {
    color: #8b96a6;
    background: transparent;
}

QFrame[canvasOverlay="true"] { background: #1a1c25; border: 1px solid #363944; border-radius: 10px; }
QFrame[canvasOverlay="true"] QLabel { background: transparent; border: none; }
QFrame#canvasDocumentControls QPushButton, QFrame#canvasViewControls QPushButton { background: transparent; border: none; }
QFrame#canvasDocumentControls QPushButton:hover, QFrame#canvasViewControls QPushButton:hover { background: #363944; }

QFrame[canvasOverlay="true"] { background: #1b2029; border-color: #38414f; }
QFrame#canvasDocumentControls QPushButton:hover,
QFrame#canvasViewControls QPushButton:hover { background: #2a3442; }
QFrame#canvasViewControls QPushButton:checked { background: #263e3b; border: 1px solid #3c6158; }
QFrame#canvasViewControls QPushButton:disabled { background: transparent; border: none; }
QFrame#canvasControlDivider { background: #343e4a; border: none; }
QFrame[canvasWindow="true"] { border-color: #424e5d; }
QMenu { background: #1d2530; border: 1px solid #3b4756; color: #dce5f0; }
QMenu::item:selected { background: #2d3c4f; }
QMenu::separator { background: #344152; }

QDialog[launcherChrome="true"] { background: #191f29; border: 1px solid #384353; }
QLabel#dialogHeading { color: #eff3f9; }
QToolButton#windowControl:hover { background: #2c3543; }
QToolButton#windowControl:pressed { background: #384353; }
QDialog QPushButton:default, QDialog QPushButton[dialogPrimary="true"] {
    background: #237bd0; border: 1px solid #378cde; color: #ffffff;
}
QDialog QPushButton:default:hover, QDialog QPushButton[dialogPrimary="true"]:hover { background: #318bdf; }
QDialog QPushButton:disabled { background: #232a35; color: #68758a; border-color: #303947; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #465164; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #65748b; }

ResourceCanvas QGraphicsView { background: #10151c; }
QWidget#resourceDetailContent { background: #191f29; }
QFrame#workflowPreviewPanel { background: #202834; border: 1px solid #354252; border-radius: 12px; }
QScrollArea#workflowPreviewScroll, QLabel#workflowPreview { background: #202834; border: none; }

QPushButton[canvasLayerFilter="true"] { background: #151c25; color: #8795a8; border: 1px solid #334052; padding: 6px 10px; }
QPushButton[canvasLayerFilter="true"]:checked { background: #273d50; color: #b9def6; border-color: #486d8b; }

QPlainTextEdit#dockerSelectedLogs { background: #141a22; color: #dce5f0; border: 1px solid #354252; border-radius: 10px; padding: 10px; }
QScrollArea#dockerDetailsScroll, QLabel#dockerReadableDetails { background: #141a22; color: #dce5f0; border: none; }

QWidget#runHistoryPage {
    background: #10151c;
}
QLabel#runCount, QLabel#runStatus {
    color: #92a2b7;
}
QWidget#runHistoryPage QTableWidget {
    background: #151c25;
    alternate-background-color: #1a222d;
    color: #dce5f0;
    selection-background-color: #273d50;
    selection-color: #edf5ff;
}

/* Shared project/workflow editor and source control. */
QWidget#editorWorkspace { background: #141920; border: 1px solid #303a48; border-radius: 10px; }
QWidget#projectFiles QPlainTextEdit { border: none; border-radius: 0px; }
QLabel#editorSectionLabel { color: #94a3b8; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
QLabel#editorMuted, QLabel#editorStatus { color: #94a3b8; font-size: 11px; }
QLabel#editorEmptyTitle { color: #dce5f0; font-size: 20px; font-weight: 600; }
QToolButton#editorIconButton, QToolButton#fileMarkdownPreviewButton { background: transparent; border: none; border-radius: 6px; padding: 6px; }
QToolButton#editorIconButton:hover, QToolButton#fileMarkdownPreviewButton:hover { background: #202a36; }
QToolButton#editorIconButton::menu-indicator { image: none; }
QPushButton#editorSave { padding: 6px 14px; min-height: 18px; }
QLabel#gitHeading { font-size: 22px; font-weight: 600; }
QLabel#gitBranch { color: #dce5f0; background: #202a36; border: 1px solid #303a48; border-radius: 6px; padding: 7px 12px; }
QListWidget#gitChangedFiles { outline: none; }
QListWidget#gitChangedFiles::item { border-radius: 6px; }
QWidget#gitCommitPanel { background: #141920; border: 1px solid #303a48; border-radius: 8px; }

/* Fullscreen dashboard menu bar: quiet controls, clear mode selection. */
QFrame#dashboardTopBar {
    background: #171c23;
    border: none;
    border-bottom: 1px solid #303943;
    border-radius: 0;
}
QFrame#dashboardTopBar QPushButton {
    background: transparent;
    color: #e8edf2;
    border: none;
    border-radius: 6px;
    padding: 4px 9px;
    min-height: 22px;
    font-size: 13px;
    font-weight: 500;
}
QFrame#dashboardTopBar QPushButton:hover { background: #2a323c; }
QFrame#dashboardTopBar QPushButton:focus { border: 1px solid #6dbaa9; }
QFrame#dashboardTopBar QPushButton#dashboardFullscreenSidebar { font-weight: 700; }
QFrame#dashboardTopBar QLabel#dashboardTitle {
    color: #aab5c1; font-size: 13px; font-weight: 500; padding: 0 8px;
}
QFrame#dashboardTopBar QLabel#dashboardClock {
    color: #e8edf2; font-size: 12px; font-weight: 500; padding: 0 10px;
}
QFrame#dashboardTopBar QFrame#dashboardModeSwitch {
    background: #303a45; border: none; border-radius: 8px;
}
QFrame#dashboardTopBar QFrame#dashboardModeSwitch QPushButton {
    padding: 2px 13px; min-height: 20px; color: #aab5c1;
}
QFrame#dashboardTopBar QFrame#dashboardModeSwitch QPushButton:checked {
    background: #394651; color: #e8edf2; font-weight: 600;
}
QFrame#dashboardTopBar QPushButton#dashboardCanvasProject { color: #aab5c1; }

/* Full-width dashboard title strips share the canvas panel palette. */
QTabBar#dashboardTabBar::tab { background: #1c222b; color: #e5eaf0; }
QTabBar#dashboardTabBar::tab:selected { background: #1c222b; color: #e5eaf0; border: 0; }

QToolButton#fileMarkdownPreviewButton:checked { background: #243e51; }

QTextBrowser#fileMarkdownPreview { background: #141920; color: #dce5f0; border: none; border-left: 1px solid #363f4c; border-radius: 0px; }

/* One explorer presentation across Files and dashboard Canvas/Tiling. */
QTreeView[dockpipeFileView="true"], QListView[dockpipeFileView="true"] {
    background: #141920; color: #dce5f0; border: none; outline: none;
    border-radius: 6px; padding: 4px; selection-background-color: #243e51;
    selection-color: #dce5f0;
}
QTreeView[dockpipeFileView="true"]::item { height: 32px; padding: 0px 6px; border-radius: 5px; }
QTreeView[dockpipeFileView="true"]::item:hover { background: #202a36; }
QTreeView[dockpipeFileView="true"]::item:selected { background: #243e51; color: #dce5f0; }
QToolButton#explorerTreeMode, QToolButton#explorerFoldersMode,
QToolButton[fileNavigation="true"], QPushButton[fileNavigation="true"] {
    background: transparent; color: #dce5f0; border: none; border-radius: 6px;
    padding: 0px; min-height: 0px;
}
QToolButton#explorerTreeMode:hover, QToolButton#explorerFoldersMode:hover,
QToolButton[fileNavigation="true"]:hover, QPushButton[fileNavigation="true"]:hover { background: #202a36; }
QToolButton#explorerTreeMode:checked, QToolButton#explorerFoldersMode:checked { background: #243e51; }
QLineEdit#dashboardFilesLocation { padding: 6px 8px; border: 1px solid #363f4c; border-radius: 6px; }
QLabel#dashboardFilesStatus { color: #dce5f0; font-size: 11px; }

QWidget#dashboardFilesWidget { background: #141920; border-radius: 6px; }

/* Shared Git history, queue, branch and conflict lists. */
QListView#gitCherryPickQueue { background: #191d24; color: #dce5f0; border: none; outline: none; }
QListWidget#gitHistoryCommits::item, QListView#gitCherryPickQueue::item,
QListWidget#gitRepositoryBranches::item, QListWidget#gitRepositoryStashes::item,
QListWidget#gitConflictFiles::item { min-height: 30px; padding: 4px 8px; border-radius: 5px; }
QListWidget#gitHistoryCommits::item:selected, QListView#gitCherryPickQueue::item:selected,
QListWidget#gitRepositoryBranches::item:selected, QListWidget#gitRepositoryStashes::item:selected,
QListWidget#gitConflictFiles::item:selected { background: #293e55; color: #dce5f0; }

/* Dashboard canvas gadgets; tiling and ordinary pages retain their presentation. */
QFrame[dashboardSpatial="true"] { background: #18212c; border: 1px solid #34495c; border-radius: 18px; }
QFrame[dashboardSpatial="true"][dashboardCapsule="true"] { border-radius: 25px; }
QFrame[dashboardSpatial="true"] QWidget#dashboardPanelHeader { background: transparent; border: none; min-height: 22px; max-height: 24px; }
QFrame[dashboardSpatial="true"] QLabel#dashboardPanelTitle { color: #92a8bd; font-size: 10px; font-weight: 600; padding-left: 8px; background: transparent; }
QFrame[dashboardSpatial="true"] QToolButton { border: none; border-radius: 10px; padding: 0px 6px; color: #92a8bd; background: transparent; }
QFrame[dashboardSpatial="true"] QToolButton:hover { color: #dde9f5; background: #34495c; }
QFrame[dashboardSpatial="true"] QWidget[dashboardKind] { background: transparent; border: none; }
