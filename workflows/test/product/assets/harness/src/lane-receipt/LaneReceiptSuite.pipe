module Dockpipe.Product.LaneReceipt.Tests;
import Dockpipe.Product.LaneReceipt;
import Dockpipe.Product.Receipt.Contracts;
import PipeLang.IO;
import PipeLang.Json;
import PipeLang.Testing;

public model Class LaneReceiptSuite {
    private JsonReader reader;
    private JsonStringIndexer indexer;
    private FileStreams files;

    public LaneReceiptSuite(JsonReader reader, JsonStringIndexer indexer, FileStreams files) {
        this.reader = reader;
        this.indexer = indexer;
        this.files = files;
    }

    public EvidenceReport Run(CancellationToken token, CancellationToken cancelled) {
        List<TestResult> results = List<TestResult>.Empty();
        TestRunner runner = new TestRunner();
        for (int scenario = 0; scenario < 30; scenario = scenario + 1)
            results.Add(runner.RunProbe(new LaneReceiptCase(reader, indexer, files, scenario), token, cancelled));

        bool allPassed = results.Count == 30;
        foreach (TestResult result in results) {
            if (result.outcome != TestOutcome.Passed || !result.bodyRan || !result.cleanupRan)
                allPassed = false;
        }

        return EvidenceReport(allPassed, results);
    }
}
