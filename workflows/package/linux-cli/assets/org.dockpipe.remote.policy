<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Dockpipe</vendor>
  <vendor_url>https://github.com/Dockpipe-Industries/dockpipe</vendor_url>
  <action id="org.dockpipe.remote.unlock">
    <description>Unlock Dockpipe remote access</description>
    <message>Authenticate to unlock Dockpipe remote access for this computer.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
