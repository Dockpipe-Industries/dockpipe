# Template for workflows/package/linux-cli/assets/scripts/build-nfpm.sh — substitutes __VERSION__, __GOARCH__, __BINARY__.
# Packagers: nfpm (apk, rpm, archlinux). See workflows/release/README.md.
name: dockpipe
version: "__VERSION__"
arch: __GOARCH__
release: "1"
platform: linux
maintainer: "dockpipe maintainers"
description: Run commands, packages and workflows across native and container runtimes.
vendor: dockpipe
homepage: https://github.com/Dockpipe-Industries/dockpipe
license: Apache-2.0
depends:
  - bash
  - git
contents:
  - src: "__BINARY__"
    dst: /usr/bin/dockpipe
    file_info:
      mode: 0755
