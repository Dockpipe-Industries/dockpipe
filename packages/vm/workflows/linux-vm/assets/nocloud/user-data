#cloud-config
apt:
  preserve_sources_list: true
package_update: false
package_upgrade: false
disable_root: true
ssh_pwauth: false
ssh_deletekeys: true
ssh_genkeytypes: [ed25519]
users:
  - name: dockpipe-agent
    system: true
    shell: /usr/sbin/nologin
    homedir: /var/lib/dockpipe-agent
    lock_passwd: true
    ssh_redirect_user: true
fs_setup:
  - label: dockpipe-qual
    filesystem: ext4
    device: /dev/disk/by-id/virtio-@@DISK_SERIAL@@
    partition: none
    overwrite: false
    extra_opts: ["-U", "@@FILESYSTEM_UUID@@", "-E", "lazy_itable_init=0,lazy_journal_init=0"]
mounts:
  - ["UUID=@@FILESYSTEM_UUID@@", "/var/lib/dockpipe-qualification", "ext4", "rw,noatime,nodev,nosuid,noexec,data=ordered", "0", "2"]
write_files:
@@WRITE_FILES@@
runcmd:
  - [systemctl, disable, --now, ssh.service, ssh.socket]
  - [systemd-sysusers, /usr/lib/sysusers.d/dockpipe-agent.conf]
  - [systemd-tmpfiles, --create, /usr/lib/tmpfiles.d/dockpipe-agent.conf]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, dockpipe-agent.service]
