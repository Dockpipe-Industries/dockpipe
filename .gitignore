# Go caches and generated build outputs.
.gocache/
.gomodcache/
.cache/
/bin/
/src/bin/
/src/cmd/dockpipe_windows_amd64.syso
/src/dockpipe-app/build/
/release/artifacts/
/aqtinstall.log
*.deb
*.wixobj
*.wixpdb

# Temporary local experiments and packaging output.
/tmp/
/.tmp/
/.codex-tmp/
/dist/
# An accidental shell redirection can create a file named "-".
/-

# Python bytecode and test caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Editor files and operating-system metadata.
*~
*.swp
*.swo
.*.sw?
.DS_Store
Thumbs.db
/docs/.obsidian/
/.vscode/settings.json

# Local identities, environment values and credentials.
.gitconfig
.env
.env.local
.env.op.template
.env.template
.env.vault.template
.env.secretstore
.ssh/
# Terraform state can contain secrets; lock files remain authored source.
.terraform/
*.tfstate
*.tfstate.*

# Private local records and runtime state.
/.local/sred/
/.staging/
.dockpipe/
.dorkpipe/
**/.pipelang/

# Repository-owned editor extension build outputs.
/tooling/vscode-extensions/*/node_modules/
/tooling/vscode-extensions/*/dist/
/tooling/vscode-extensions/*/*.vsix

# Local assistant and editor-server state.
.agents/
.claude/
.codex/
.glider-trace/
.cursor-server/
.cursor/
